# GODNSLOG Frontend Environment Variables
# Copy this file to .env.local and adjust as needed

# Backend API URL (used by Next.js server-side rewrites proxy)
# Change this to your GODNSLOG backend address
GODNSLOG_API_URL=http://localhost:8080

# Public API URL (used by browser-side axios client)
# Leave empty to use relative path /api/v2 (recommended, goes through Next.js proxy)
# Set this only if your backend is on a different origin and you want direct browser access
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v2
